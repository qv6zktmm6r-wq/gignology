# Runtime owner email is used only for the first verified-owner sign-in.
# Subsequent owner access is bound to the Site-specific authenticated user ID.
OWNER_EMAIL=

# Vercel public-site relay. Set these as server-side Vercel environment variables.
# Never prefix credentials with NEXT_PUBLIC_ or put them into public assets.
SITES_BACKEND_ORIGIN=https://gignology-solutions.mejia1604.chatgpt.site
SITES_BACKEND_TOKEN=

# Generate a random secret of at least 32 characters. Configure the same value
# in Vercel and as a Sites runtime secret; it authenticates relayed visitor IPs.
GIGNOLOGY_RELAY_SECRET=
